{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tapalka-znushuk-silpo-mcp",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  }
}
